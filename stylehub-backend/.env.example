# Copy this file to .env and fill in the values. NEVER commit .env.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

DATABASE_URL=sqlite:///./stylehub.db

# Stripe (TEST MODE keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=replace_with_your_own_value
STRIPE_PUBLISHABLE_KEY=replace_with_your_own_value
# From `stripe listen --forward-to localhost:8000/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=replace_with_your_own_value
CURRENCY=usd

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Seed demo products on first start (only when the products table is empty)
SEED_PRODUCTS=true
